# ------------------------------------------------------------------
# Device / platform
# ------------------------------------------------------------------
# Android SDK location (needed by Appium/UiAutomator2).
# Windows example: C:\Users\<you>\AppData\Local\Android\Sdk
# macOS example:   /Users/<you>/Library/Android/sdk
# ANDROID_HOME=

# Android (default) or iOS
PLATFORM_NAME=Android

# Android: UiAutomator2 | iOS: XCUITest
AUTOMATION_NAME=UiAutomator2

# Emulator/simulator or real device name
DEVICE_NAME=Android Emulator

# Optional but recommended to target a specific device
# DEVICE_UDID=emulator-5554
# PLATFORM_VERSION=14

# ------------------------------------------------------------------
# App under test (99 app, NOT the Pro app)
# ------------------------------------------------------------------
# Either point to a local build file...
# APP_PATH=./apps/99.apk

# ...or launch an already-installed app by package/activity.
# 99.co Indonesia (non-Pro) official package:
APP_PACKAGE=com.urbanindo.android
# Optional: leave empty to let Appium launch the default activity.
# APP_ACTIVITY=

# Keep app data between runs (true) or reset it (false)
NO_RESET=true
FULL_RESET=false

# ------------------------------------------------------------------
# Appium server
# ------------------------------------------------------------------
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_BASE_PATH=/

# ------------------------------------------------------------------
# Misc
# ------------------------------------------------------------------
LOG_LEVEL=info
WAIT_FOR_TIMEOUT=20000
